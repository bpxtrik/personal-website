---
interface Props {
  title?: string;
  hero?: boolean;
  class?: string;
}
const { title = 'patrik@barsi.xyz: ~', hero = false, class: cls = '' } = Astro.props;
---

<section class:list={['win', { 'win--hero': hero }, cls]}>
  <header class="win__bar">
    <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="win__title">{title}</span>
  </header>
  <div class="win__body">
    <slot />
  </div>
</section>
