---
import Base from '../layouts/Base.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import ShellBlock from '../components/ShellBlock.astro';
import { aboutLines, whoamiLines, educationLines } from '../lib/shell';
import { profile } from '../data/site';
---

<Base title={`about — ${profile.name}`} description={profile.summary}>
  <header class="pagehead">
    <h1>about</h1>
    <p>{profile.tagline}</p>
  </header>

  <TerminalWindow title="patrik@barsi.xyz: ~/about">
    <div class="transcript">
      <ShellBlock cmd="whoami" lines={whoamiLines()} />
      <ShellBlock cmd="cat about.txt" lines={aboutLines()} />
      <ShellBlock cmd="cat education.md" lines={educationLines()} />
    </div>
  </TerminalWindow>

  <a class="back" href="/">back to shell</a>
</Base>
